---
import type { DeliveryPlatform } from '@/config/site';

interface Props {
  platform: DeliveryPlatform;
}
const { platform } = Astro.props;

const logos: Record<string, string> = {
  Talabat: '/images/platforms/talabat.png',
  Deliveroo: '/images/platforms/deliveroo.svg',
  Careem: '/images/platforms/careem.svg',
  'Noon Food': '/images/platforms/noon-food.png',
};
const logo = logos[platform.name];
---

<a
  class="platform"
  href={platform.url}
  target="_blank"
  rel="noopener noreferrer"
  data-demo={platform.demo ? '' : undefined}
  aria-label={`Order on ${platform.name}`}
>
  {logo ? (
    <img class="platform__logo" src={logo} alt="" aria-hidden="true" />
  ) : (
    <span class="platform__name">{platform.name}</span>
  )}
</a>

<style>
  .platform {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    min-height: 56px;
    padding: 0 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    color: var(--text);
    font-size: var(--fs-body);
    letter-spacing: 0.01em;
    background: color-mix(in srgb, var(--surface) 40%, transparent);
    transition:
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-1) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }
  .platform:hover {
    border-color: var(--brass);
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }
  .platform__name {
    font-weight: 500;
  }
  .platform__logo {
    display: block;
    width: auto;
    max-width: 190px;
    height: 46px;
    object-fit: contain;
  }
  @media (prefers-reduced-motion: reduce) {
    .platform {
      transition: border-color var(--dur-2);
    }
    .platform:hover {
      transform: none;
    }
  }
</style>
